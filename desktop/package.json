{
	"name": "desktop",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"i18n": "paraglide-js compile --project ../packages/ui/project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hugeicons/core-free-icons": "^4.4.0",
		"@hugeicons/svelte": "^1.1.5",
		"@inlang/paraglide-js": "^2.18.2",
		"@spam-live/ui": "workspace:*",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^26",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
